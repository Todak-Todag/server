discovery.docker "todak" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "todak" {
  targets = discovery.docker.todak.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "todak" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.todak.targets
  relabel_rules = discovery.relabel.todak.rules

  forward_to = [
    loki.write.todak.receiver,
  ]
}

loki.write "todak" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}